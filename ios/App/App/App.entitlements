<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.bostonbijold.tapcheck.shared</string>
	</array>
	<!-- Required to receive a Live Activity push token at all (see
	     LiveActivityPlugin.swift's observePushToken and
	     docs/features/live-activity.md's "Push-driven updates" section) —
	     the same underlying aps-environment entitlement regular remote
	     notifications would need, if this app ever adds those too.
	     "development" matches this project's only build config today
	     (Debug/Development-signed, per app-intents.md's deployment-target
	     note); update to "production" alongside a Distribution-signed
	     Release build. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links for the NFC feature (see docs/features/nfc.md) —
	     lets a tap on https://tap-check.vercel.app/nfc/<tagCode> route
	     straight into the app instead of Safari. Requires the paid Apple
	     Developer Program team (free Personal Team accounts can't use this
	     capability at all). Domain must match capacitor.config.ts's
	     server.url and app/.well-known/apple-app-site-association's own
	     scoping. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:tap-check.vercel.app</string>
	</array>
</dict>
</plist>
